<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" oor:name="Sidebar" oor:package="org.openoffice.Office.UI">
  <node oor:name="Content">
    <node oor:name="DeckList">
      <node oor:name="ClaudeCalcDeck" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string"><value>Claude</value></prop>
        <prop oor:name="Id" oor:type="xs:string"><value>ClaudeCalcDeck</value></prop>
        <prop oor:name="IconURL" oor:type="xs:string"><value>vnd.sun.star.extension://com.claudecalc.sidebar/images/icon26.png</value></prop>
        <prop oor:name="HighContrastIconURL" oor:type="xs:string"><value>vnd.sun.star.extension://com.claudecalc.sidebar/images/icon26.png</value></prop>
        <prop oor:name="ContextList">
          <value oor:separator=";">Calc, any, visible ;</value>
        </prop>
        <prop oor:name="OrderIndex" oor:type="xs:int"><value>10000</value></prop>
      </node>
    </node>
    <node oor:name="PanelList">
      <node oor:name="ClaudeCalcPanel" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string"><value>Claude</value></prop>
        <prop oor:name="Id" oor:type="xs:string"><value>ClaudeCalcPanel</value></prop>
        <prop oor:name="DeckId" oor:type="xs:string"><value>ClaudeCalcDeck</value></prop>
        <prop oor:name="ContextList">
          <value oor:separator=";">Calc, any, visible ;</value>
        </prop>
        <prop oor:name="ImplementationURL" oor:type="xs:string"><value>private:resource/toolpanel/ClaudeCalcFactory/ClaudeCalcPanel</value></prop>
        <prop oor:name="OrderIndex" oor:type="xs:int"><value>100</value></prop>
        <prop oor:name="ShowForReadOnlyDocument" oor:type="xs:boolean"><value>true</value></prop>
        <prop oor:name="WantsCanvas" oor:type="xs:boolean"><value>false</value></prop>
      </node>
    </node>
  </node>
</oor:component-data>
